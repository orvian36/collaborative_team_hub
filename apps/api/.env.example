DATABASE_URL=postgresql://user:pass@localhost:5432/team_hub
JWT_ACCESS_SECRET=replace-me-32-bytes-hex
JWT_REFRESH_SECRET=replace-me-32-bytes-hex
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLIENT_URL=http://localhost:3000
# Email — Gmail SMTP via App Password example
# Get an App Password at https://myaccount.google.com/apppasswords
# (requires 2-Step Verification on the Google account)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your.address@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
SMTP_FROM=Team Hub <your.address@gmail.com>
PORT=5000

# Environment: 'development' locally, 'production' on Railway
# Production switches auth cookies to Secure + SameSite=None for cross-site flow
NODE_ENV=development
